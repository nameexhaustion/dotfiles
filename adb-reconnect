#!/usr/bin/env python3
"""Connect adb to this machine's wireless-debugging port.

Android picks a new random port each time wireless debugging starts, and
mDNS doesn't reach us here, so: connect-scan every TCP port, greet each open
one with an ADB CNXN, and `adb connect` to the one that answers like adbd.

usage: ~/adb [host]     (host defaults to 127.0.0.1)
"""
import errno, re, resource, select, socket, struct, subprocess, sys, time
from concurrent.futures import ThreadPoolExecutor, as_completed

HOST = sys.argv[1] if len(sys.argv) > 1 else '127.0.0.1'
ADB_SERVER_PORT = 5037
# Android's ephemeral range (where adbd's port lands) first, then the rest.
PORTS = [p for p in (*range(32768, 61000), *range(1024, 32768), *range(61000, 65536))
         if p != ADB_SERVER_PORT]
BATCH = min(2000, resource.getrlimit(resource.RLIMIT_NOFILE)[0] - 64)
CONNECT_WAIT = 0.3   # per batch; loopback answers in well under a millisecond
PROBE_WAIT = 0.4


def adb(*args):
    r = subprocess.run(['adb', *args], capture_output=True, text=True, timeout=10)
    return (r.stdout + r.stderr).strip()


def devices():
    """{serial: state} for this host's connections."""
    lines = adb('devices').splitlines()[1:]
    return {s: st for s, st in (l.split()[:2] for l in lines if l.strip())
            if s.startswith(HOST + ':')}


def open_ports():
    found = []
    for i in range(0, len(PORTS), BATCH):
        pending = {}
        ep = select.epoll()
        for p in PORTS[i:i + BATCH]:
            s = socket.socket()
            s.setblocking(False)
            e = s.connect_ex((HOST, p))
            if e == errno.EINPROGRESS:
                pending[s.fileno()] = (s, p)
                ep.register(s, select.EPOLLOUT)
                continue
            if e == 0:
                found.append(p)
            s.close()
        deadline = time.monotonic() + CONNECT_WAIT
        while pending and (left := deadline - time.monotonic()) > 0:
            for fd, _ in ep.poll(left):
                s, p = pending.pop(fd)
                if s.getsockopt(socket.SOL_SOCKET, socket.SO_ERROR) == 0:
                    found.append(p)
                s.close()
        for s, _ in pending.values():   # no answer in time: filtered
            s.close()
        ep.close()
    return found


def cnxn():
    cmd = int.from_bytes(b'CNXN', 'little')
    data = b'host::\0'
    return struct.pack('<6I', cmd, 0x01000001, 256 * 1024, len(data),
                       sum(data), cmd ^ 0xffffffff) + data


def is_adbd(port):
    """adbd answers a CNXN with CNXN, AUTH, or (wireless debugging) STLS."""
    try:
        with socket.create_connection((HOST, port), PROBE_WAIT) as s:
            s.settimeout(PROBE_WAIT)
            s.sendall(cnxn())
            return s.recv(4, socket.MSG_WAITALL) in (b'CNXN', b'AUTH', b'STLS')
    except OSError:
        return False


def find_adbd():
    ports = open_ports()
    if not ports:
        return None
    pool = ThreadPoolExecutor(len(ports))
    futures = {pool.submit(is_adbd, p): p for p in ports}
    port = next((futures[f] for f in as_completed(futures) if f.result()), None)
    pool.shutdown(wait=False, cancel_futures=True)
    return port


def report(serial, took):
    props = dict(re.findall(r'^\[(.+?)\]: \[(.*)\]$', adb('-s', serial, 'shell', 'getprop'), re.M))
    p = lambda k: props.get(k, '?')
    print(f'connected {serial} in {took:.1f}s\n'
          f'  port:    {serial.rsplit(":", 1)[1]}\n'
          f'  device:  {p("ro.product.manufacturer")} {p("ro.product.model")} '
          f'({p("ro.product.device")})\n'
          f'  android: {p("ro.build.version.release")} (SDK {p("ro.build.version.sdk")})')


def main():
    t = time.monotonic()
    for serial, state in devices().items():
        if state == 'device':
            report(serial, time.monotonic() - t)
            return 0
        adb('disconnect', serial)   # a port adbd no longer listens on

    for attempt in range(3):        # right after a toggle the port may still be moving
        if attempt:
            time.sleep(0.5)
        port = find_adbd()
        if port is None:
            continue
        serial = f'{HOST}:{port}'
        out = adb('connect', serial)
        state = devices().get(serial)
        if state == 'device':
            report(serial, time.monotonic() - t)
            return 0
        adb('disconnect', serial)
        if state == 'unauthorized' or 'authenticate' in out:
            print(f'{serial} is adbd but this host is not authorized: accept the prompt on the '
                  f'device, or pair first (adb pair {HOST}:<pairing port>)', file=sys.stderr)
            return 1
    print(f'no adbd on {HOST}: is wireless debugging on?', file=sys.stderr)
    return 1


if __name__ == '__main__':
    sys.exit(main())
