#!/bin/bash
# sysmon: an Android device's power, thermal, CPU, GPU, memory and network at a glance, over adb.
#
#   sysmon       one snapshot
#   sysmon N     refresh every N seconds, full screen like watch
#
# With more than one device attached it asks which (ANDROID_SERIAL skips that).
#
# Colour goes to a terminal and to `sysmon N`; NO_COLOR=1 turns it off and
# SYSMON_COLOR=1 or 0 forces it either way.
#
# One adb round trip per snapshot (two when pw.dex has to be pushed first).
# Rates (CPU %, network, the battery's average current) are deltas against the
# previous snapshot, kept on the device in /data/local/tmp/sysmon/state.<id>:
# one id per `sysmon N`, one shared by single snapshots, so two copies running
# at once don't take each other's baseline. The battery current comes from
# pw.dex, built from ~/.cache/sysmon/Pw.java and run with app_process, since
# sysfs's power_supply is closed to the shell user; without it the rest still works.
#
# Generic Android (toybox, mksh, dumpsys) except where noted: the thermal zone
# names, core_ctl's parked cores and the GPU's kgsl are Qualcomm's, and the surface sensors are
# one vendor's. Whatever a device lacks is left out.

# What it's doing while the terminal would otherwise sit blank: one dim line on
# stderr, cleared once there's something else to show. Not for the snapshots
# of `sysmon N`, whose header says instead.
if [[ -t 2 && -z $SYSMON_ID ]]; then
  say() { printf '\r\e[2m%s\e[0m\e[K' "$*" >&2; }
  unsay() { printf '\r\e[K' >&2; }
else
  say() { :; }; unsay() { :; }
fi

# More than one device: pick one with the arrow keys and Enter (q or Esc quits).
# It's passed on in ANDROID_SERIAL, which adb reads, so every snapshot of
# `sysmon N` uses it; set ANDROID_SERIAL yourself to skip the question. The
# only one gets it too: adb itself would refuse to choose when an unauthorized
# or offline device is attached as well.
if [[ -z $ANDROID_SERIAL ]]; then
  say "Looking for devices…"
  mapfile -t serials < <(adb devices 2>/dev/null | awk 'NR > 1 && $2 == "device" { print $1 }')
  n=${#serials[@]}
  (( n == 1 )) && export ANDROID_SERIAL=${serials[0]}
  unsay
  if (( n > 1 )); then
    if [[ ! -t 0 || ! -t 2 ]]; then
      echo "sysmon: $n devices attached; set ANDROID_SERIAL to one of them" >&2
      exit 1
    fi
    # Each device's name (Settings → About), its marketing name and its model,
    # asked of all of them at once.
    say "Asking the $n devices who they are…"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"; unsay' EXIT
    for i in "${!serials[@]}"; do
      timeout 3 adb -s "${serials[i]}" shell 'settings get global device_name; getprop ro.config.marketing_name;
        echo "$(getprop ro.product.manufacturer) $(getprop ro.product.model)"; getprop ro.product.model' > "$tmp/$i" 2>/dev/null &
    done
    wait
    names=() markets=() models=()
    for i in "${!serials[@]}"; do
      { read -r name; read -r market; read -r fallback; read -r model; } < "$tmp/$i"
      [[ $name == null ]] && name=
      [[ -z $market ]] && market=$fallback
      [[ $market == "$name" ]] && market=
      names[i]=${name:-${market:-${serials[i]}}} markets[i]=$market models[i]=$model
    done
    rm -rf "$tmp"
    unsay

    # Columns padded by what they take on screen (wc -L): 荣耀 is two columns a character.
    width() { printf %s "$1" | wc -L; }
    pad() { printf '%s%*s' "$1" $(( $2 - $(width "$1") )) ''; }
    wn=0 wm=0 wd=0
    for i in "${!serials[@]}"; do
      (( $(width "${names[i]}") > wn )) && wn=$(width "${names[i]}")
      (( $(width "${markets[i]}") > wm )) && wm=$(width "${markets[i]}")
      (( ${#models[i]} > wd )) && wd=${#models[i]}
    done
    rows=()
    for i in "${!serials[@]}"; do
      rows[i]="$(pad "${names[i]}" $wn)\e[22m   $(pad "${markets[i]}" $wm)   $(pad "${models[i]}" $wd)   \e[2m${serials[i]}"
    done

    sel=0
    tput civis >&2
    trap 'tput cnorm >&2' EXIT
    printf '\e[1mWhich device?\e[0m  \e[2m↑/↓ move · Enter pick · q quit\e[0m\n\n' >&2
    while :; do
      for i in "${!serials[@]}"; do
        if (( i == sel )); then printf '\e[7m ▸ \e[1m%b \e[0m\e[K\n' "${rows[i]}"
        else printf '   \e[1m%b\e[0m\e[K\n' "${rows[i]}"
        fi
      done >&2
      IFS= read -rsn1 key
      if [[ $key == $'\e' ]]; then read -rsn2 -t 0.05 rest; key+=$rest; fi
      case $key in
        $'\e[A'|$'\eOA'|k) (( sel = (sel + n - 1) % n ));;
        $'\e[B'|$'\eOB'|j) (( sel = (sel + 1) % n ));;
        '') break;;
        q|$'\e') printf '\e[%dA\e[J' $(( n + 2 )) >&2; exit 1;;
      esac
      printf '\e[%dA' $n >&2
    done
    printf '\e[%dA\e[J' $(( n + 2 )) >&2    # the DEVICE line says which it was
    tput cnorm >&2
    trap - EXIT
    export ANDROID_SERIAL=${serials[sel]} label=${names[sel]}
  fi
fi

# `sysmon N`: a snapshot every N seconds, each run as `sysmon` and drawn over the
# last once it's all in, so the screen never sits blank: "Connecting to …"
# until the first, then the last one with its time, and "updating…" in the
# header while the next is fetched. On the alternate screen, like watch.
if [[ $1 =~ ^[0-9]+$ ]]; then
  export SYSMON_ID=$$    # the snapshots' baseline on the device, one per `sysmon N`
  [[ -z $NO_COLOR ]] && export SYSMON_COLOR=${SYSMON_COLOR:-1}
  if [[ ! -t 1 ]]; then
    while :; do "$0"; echo; sleep "$1"; done
  fi
  dim= off=
  [[ $SYSMON_COLOR == 1 ]] && dim=$'\e[2m' off=$'\e[0m'
  title="sysmon · ${label:-${ANDROID_SERIAL:-the device}} · every $1 s"
  header() { printf '\e[H%s%s%s\e[K' "$dim" "$title${1:+ · $1}" "$off"; }
  # Keys typed meanwhile aren't echoed into the frame (watch's curses does the same).
  tty=$(stty -g)
  tput smcup; tput civis; stty -echo
  trap 'stty "$tty"; tput cnorm; tput rmcup' EXIT
  trap 'exit 130' INT TERM HUP
  printf '\e[H\e[J'; header; printf '\n\n%sConnecting to %s…%s' "$dim" "${label:-${ANDROID_SERIAL:-the device}}" "$off"
  while :; do
    out=$(COLUMNS=$(tput cols) "$0" 2>&1)
    at=$(date +%T)
    # Cut to the screen (two lines go to the header), each line clearing what
    # the last frame left after it.
    header "$at"; printf '\n\n%s\e[J' "$(head -n $(( $(tput lines) - 2 )) <<< "$out" | sed $'s/$/\e[K/')"
    sleep "$1"
    header "$at · updating…"
  done
fi

T=/data/local/tmp/sysmon
dex=~/.cache/sysmon/pw.dex

if [[ -n $NO_COLOR ]]; then color=0
elif [[ -n $SYSMON_COLOR ]]; then color=$SYSMON_COLOR
elif [[ -t 1 ]]; then color=1
else color=0
fi

# The terminal's width decides whether the two TOP lists sit side by side
# (`sysmon N` sets COLUMNS; tput reads it straight from the terminal otherwise).
cols=${COLUMNS:-$(tput cols 2>/dev/null)}

# pw.dex's checksum, so a stale copy on the device gets replaced ("none": no current).
dexsum=none
[[ -f $dex ]] && dexsum=$(md5sum < "$dex" | cut -d' ' -f1)

# The serial the DEVICE line shows (the device's own when adb picked the only one).
serial=${ANDROID_SERIAL:-$(adb get-serialno 2>/dev/null)}

# Passed as an argument, not on stdin: the jobs it runs would read stdin too.
script="T=$T; ID=${SYSMON_ID:-once}; DEX=$dexsum; COLS=${cols:-80}; COLOR=$color; SERIAL=$(printf %q "$serial"); $(cat <<'EOF'
# Exit 3, before printing anything, when the device's pw.dex isn't ours.
[ $DEX = none ] || [ "$(md5sum $T/pw.dex 2>/dev/null | cut -d' ' -f1)" = $DEX ] || exit 3

# adbd lets a command run on when its client goes away, so the snapshot ends
# itself: after 15 s (it takes ~1.5) whatever's still running of it, a hung
# service call or a wait on another snapshot's lock, gets TERM (the shell's
# trap clears its files) and a second later KILL. Sent to the process group,
# which is just the snapshot's: adbd starts the shell as a group of its own.
# A snapshot that finishes stops it. Off adbd's pipe, so it holds nothing open.
# (exec, not a redirection on the subshell: mksh would keep adbd's fds as 10-12.)
( exec < /dev/null > /dev/null 2>&1
  trap 'kill $s; exit' TERM; sleep 15 & s=$!; wait $s
  trap '' TERM; kill -TERM 0; sleep 1; kill -KILL 0 ) &
WD=$!

# This snapshot's own files go in R; the baselines in S, held under S's lock
# for the whole snapshot. The lock comes in on a redirection to snapshot: an
# fd opened with mksh's exec is closed to the commands it runs. Leftovers of
# killed runs and finished `sysmon N`s go after a day.
S=$T/state.$ID
mkdir -p $S
snapshot() {
  flock 9
  R=$(mktemp -d $T/run.XXXXXX)
  # mksh exits with the EXIT trap's last status, so it's kept by hand: a
  # snapshot the watchdog stopped ends 1, not 0.
  trap 'st=${st:-$?}; rm -rf $R; kill $WD 2>/dev/null; exit $st' EXIT
  trap 'st=1; exit 1' HUP INT TERM
  cd $R
  find $T -maxdepth 1 \( -name 'run.*' -o -name 'state.*' \) -mmin +1440 -exec rm -rf {} + 2>/dev/null

  # Every awk below reads these: H heading, W warning, A alarm, D dim, N reset.
  if [ "$COLOR" = 1 ]; then
    export H=$'\e[1m' W=$'\e[33m' A=$'\e[1;31m' D=$'\e[2m' N=$'\e[0m'
  else
    export H= W= A= D= N=
  fi
  # Layout shared by every section: headings and labels in a 14-column gutter.
  # A value too long for the terminal goes on under the gutter, broken only at
  # the "\001"s in it (spaces at the break dropped).
  export COLS LIB='
    function head(name, rest) { fit(ENVIRON["H"] sprintf("%-14s", name) ENVIRON["N"], rest) }
    function row(label, rest) { if (rest != "") fit(sprintf("  %-12s", label), rest) }
    function fit(lead, rest,   p, n, i, line, piece, cols) {
      cols = ENVIRON["COLS"] + 0; if (cols < 20) cols = 80
      n = split(rest, p, "\001"); line = lead p[1]
      for (i = 2; i <= n; i++) {
        piece = p[i]
        if (shown(line piece) <= cols) { line = line piece; continue }
        sub(/ +$/, "", line); print line
        sub(/^ +/, "", piece); line = sprintf("%14s", "") piece
      }
      print line
    }
    # Columns on screen: no colour codes, and a UTF-8 character (°) as one
    # though awk counts its bytes.
    function shown(s) { gsub(/\033\[[0-9;]*m/, "", s); gsub(/[\200-\277]/, "", s); return length(s) }
    function warn(s) { return ENVIRON["W"] s ENVIRON["N"] }
    function alarm(s) { return ENVIRON["A"] s ENVIRON["N"] }
    function dim(s) { return ENVIRON["D"] s ENVIRON["N"] }
    function join(a, n,   s, i) { for (i = 1; i <= n; i++) s = s (i > 1 ? "   \001" : "") a[i]; return s }
  '

  # The slow ones (app_process ~1.3 s, top ~0.4 s each) run while the rest is
  # read. Waited for by pid: a bare wait would sit out the watchdog too.
  [ $DEX = none ] || CLASSPATH=$T/pw.dex app_process / Pw > cur 2>/dev/null &
  jobs=$!
  top -b -n 1 -q -o PID,%CPU,RES,NAME -s 2 > top 2>/dev/null &
  jobs="$jobs $!"
  top -b -n 1 -q -o PID,%CPU,RES,NAME -s 3 > topmem 2>/dev/null &
  jobs="$jobs $!"

  {
  # --- THERMAL: sysfs zones (m°C) grouped by block, and the framework's throttling status.
  throttle=$(dumpsys thermalservice 2>/dev/null | awk '
    /^Thermal Status:/ { split("none light moderate severe critical emergency shutdown", s, " "); st = s[$3 + 1] }
    /^Current temperatures from HAL/ { cur = 1; next }
    cur && /mStatus=[1-9]/ { match($0, /mName=[^,]*/); hot = hot (hot ? ", " : "") substr($0, RSTART + 6, RLENGTH - 6) }
    cur && !/Temperature/ { cur = 0 }
    END { printf "%s%s", st, hot ? " (" hot ")" : "" }')
  grep -H . /sys/class/thermal/thermal_zone*/type /sys/class/thermal/thermal_zone*/temp 2>/dev/null |
  awk -F: -v throttle="$throttle" "$LIB"'
    { split($1, p, "/"); z = p[5] }
    $1 ~ /type$/ { type[z] = $2; next }
    { temp[z] = $2 }
    function grp(n) {
      if (n ~ /^cpu-hw-trip/) return ""
      if (n ~ /^cpu/) return "CPU"
      if (n ~ /^gpuss/) return "GPU"
      if (n ~ /^nsp/) return "NPU"
      if (n == "ddr") return "Memory"
      if (n ~ /^qmx/) return "SoC rails"
      if (n ~ /^mdmss|^pa_|rfboard/) return "Modem/RF"
      if (n ~ /^camera|^video/) return "Camera"
      if (n ~ /^pm.*_tz$|^dcxo/) return "PMIC"
      return ""
    }
    # Silicon is fine well past what the case and the battery should reach.
    function deg(t, chip,   s) {
      s = sprintf("%.0f", t)
      return t >= (chip ? 85 : 45) ? alarm(s) : t >= (chip ? 70 : 40) ? warn(s) : s
    }
    # "sensor:label" pairs, as "label 31   label 30 ...".
    function pairs(list,   k, a, out, n, m, i) {
      n = split(list, k, " ")
      for (i = 1; i <= n; i++) { split(k[i], a, ":"); if (a[1] in one) out[++m] = a[2] " " deg(one[a[1]], 0) }
      return join(out, m)
    }
    END {
      for (z in type) {
        n = type[z]; if (temp[z] == "") continue
        t = temp[z] / 1000; one[n] = t
        g = grp(n); if (g == "") continue
        if (!(g in mx) || t > mx[g]) mx[g] = t
        if (!(g in mn) || t < mn[g]) mn[g] = t
      }
      head("THERMAL", "throttling " (throttle == "" ? warn("unknown") : throttle == "none" ? dim("none") : alarm(throttle)))
      split("CPU GPU NPU Memory SoC_rails Modem/RF Camera", order, " ")
      for (i = 1; i in order; i++) {
        g = order[i]; gsub(/_/, " ", g); if (!(g in mx)) continue
        r = deg(mn[g], 1); if (sprintf("%.0f", mx[g]) != sprintf("%.0f", mn[g])) r = r "-" deg(mx[g], 1)
        row(g, r " °C")
      }
      row("Surface", pairs("hot_pock:hotspot system_h:inside lcd:screen shell_front:front shell_back:back shell_frame:frame"))
      s = pairs("charger:charger battery:battery usb_port:usb-port")
      if ("PMIC" in mx) s = s (s != "" ? "   \001" : "") "PMIC " deg(mx["PMIC"], 1)
      row("Charging", s)
    }'
  echo

  # --- CPU: each cluster's cores' use since the last snapshot, its clock and its
  # cap, and the cores core_ctl has parked (paused: nothing runs there) or partly
  # parked (only some tasks may run there).
  cat /sys/devices/system/cpu/cpu0/core_ctl/global_state > park 2>/dev/null
  grep -H . /sys/devices/system/cpu/cpufreq/policy*/related_cpus /sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq \
    /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq /sys/devices/system/cpu/cpufreq/policy*/cpuinfo_max_freq > freq 2>/dev/null
  awk -v st=$S/stat "$LIB"'
    BEGIN { while ((getline l < st) > 0) { split(l, f, " "); pt[f[1]] = f[2]; pi[f[1]] = f[3]; had = 1 } }
    FILENAME == "park" {
      if ($1 == "CPU:") pc = "cpu" $2
      if ($1 == "Paused:") { if ($2) parked[pc] = 1; else if ($5) partly[pc] = 1 }
      next
    }
    FILENAME == "freq" { split($0, p, "/"); split($0, v, ":"); sub(/:.*/, "", p[8]); pol[p[7]] = 1; val[p[7], p[8]] = v[2]; next }
    /^cpu/ {
      t = 0; for (i = 2; i <= NF; i++) t += $i; idle = $5 + $6
      print $1, t, idle > (st ".new")
      dt = t - pt[$1]; di = idle - pi[$1]; u[$1] = dt > 0 ? 100 * (dt - di) / dt : 0
    }
    END {
      getline la < "/proc/loadavg"; split(la, L, " ")
      head("CPU", sprintf("%.0f%% busy%s   \001load %s / %s / %s", u["cpu"], had ? "" : " since boot", L[1], L[2], L[3]))
      for (q in pol) order[substr(q, 7) + 0] = q
      for (i = 0; i < 64; i++) {
        if (!(i in order)) continue; q = order[i]
        nc = split(val[q, "related_cpus"], c, " "); cells = ""; np = npart = 0
        for (j = 1; j <= nc; j++) {
          k = "cpu" c[j]
          if (k in parked) { cells = cells warn(" park"); np++; continue }
          s = sprintf("%4.0f%%", u[k])
          if (k in partly) { s = warn(s); npart++ } else if (u[k] >= 90) s = ENVIRON["H"] s ENVIRON["N"]
          cells = cells s
        }
        cells = cells sprintf("%*s", 32 - 5 * nc, "")    # not %-32s: that would count the colour codes
        cur = val[q, "scaling_cur_freq"] / 1e6; hw = val[q, "cpuinfo_max_freq"] / 1e6; cap = val[q, "scaling_max_freq"] / 1e6
        s = sprintf("%.2f of %.2f GHz", cur, hw)
        if (cap < hw) s = s ",\001 " warn(sprintf("capped at %.2f", cap))
        if (np) s = s ",\001 " warn(np == nc ? "all parked" : np " parked")
        if (npart) s = s ",\001 " warn(npart " partly parked")
        row("cpu" c[1] "-" c[nc], cells " \001" s)
      }
    }' freq park /proc/stat
  mv $S/stat.new $S/stat
  echo

  # --- GPU: busy over the driver's last ~1 s window, busy and total in us (both
  # 0 when it was idle throughout). Not since the last snapshot, and the clock
  # is closed to the shell user.
  awk "$LIB"'
    NF == 2 { u = $2 > 0 ? 100 * $1 / $2 : 0; s = sprintf("%.0f%%", u)
              head("GPU", (u >= 90 ? ENVIRON["H"] s ENVIRON["N"] : s) " busy " dim("(last second)")) }' /sys/class/kgsl/kgsl-3d0/gpubusy 2>/dev/null

  # --- MEMORY, DISPLAY, NETWORK: a line each.
  awk "$LIB"'
    /^(MemTotal|MemAvailable|SwapTotal|SwapFree):/ { m[$1] = $2 / 1048576 }
    END {
      free = sprintf("%.1f", m["MemAvailable:"])
      head("MEMORY", (m["MemAvailable:"] < 1 ? warn(free) : free) sprintf(" of %.1f GB free   \001swap %.1f of %.1f GB used",
        m["MemTotal:"], m["SwapTotal:"] - m["SwapFree:"], m["SwapTotal:"]))
    }' /proc/meminfo
  awk -v b="$(settings get system screen_brightness)" "$LIB"'BEGIN { head("DISPLAY", "brightness " b) }'
  awk -v st=$S/net "$LIB"'
    BEGIN { while ((getline l < st) > 0) { split(l, f, " "); pr[f[1]] = f[2]; ptx[f[1]] = f[3]; pts = f[4] }
            getline up < "/proc/uptime"; split(up, U, " "); now = U[1] }
    /:/ { sub(/:/, " "); if ($1 ~ /^(lo|dummy|ip6|sit|ifb|bond)/ || $2 == 0) next
          print $1, $2, $10, now > (st ".new")
          if (pts && now > pts && ($1 in pr))
            ifs[++n] = sprintf("%s %.0f/%.0f %s", $1,
              ($2 - pr[$1]) / 1024 / (now - pts), ($10 - ptx[$1]) / 1024 / (now - pts), dim("kB/s rx/tx")) }
    END { head("NETWORK", n ? join(ifs, n) : dim("rates from the next snapshot")) }' /proc/net/dev
  mv $S/net.new $S/net
  } > out

  # --- DEVICE: whose stats these are. Then POWER, once the battery current is in.
  wait $jobs
  # Its name (Settings → About), its marketing name (Honor's; the maker's
  # otherwise), its model, Android release and adb serial.
  market=$(getprop ro.config.marketing_name)
  awk -v name="$(settings get global device_name)" -v market="${market:-$(getprop ro.product.manufacturer) $(getprop ro.product.model)}" \
    -v model="$(getprop ro.product.model)" -v a="$(getprop ro.build.version.release)" -v s="$SERIAL" "$LIB"'
    BEGIN {
      if (name == "null" || name == market) name = ""
      d = name != "" ? ENVIRON["H"] name ENVIRON["N"] "   \001" market : ENVIRON["H"] market ENVIRON["N"]
      if (index(market, model) == 0) d = d " " dim("(" model ")")
      head("DEVICE", d "   \001Android " a (s != "" ? "   \001" dim(s) : ""))
    }'
  echo
  dumpsys battery | awk -v cur="$(cat cur 2>/dev/null)" -v dex=$DEX -v avg=$S/avg "$LIB"'
    /^ *Charge counter:/ { cc = $3 }
    /^ *Max charging current:/ { mi = $4 } /^ *Max charging voltage:/ { mv = $4 }
    /^ *level:/ { lvl = $2 } /^ *voltage:/ { v = $2 } /^ *temperature:/ { t = $2 / 10 }
    /^ *AC powered: true/ { src = src "/AC" } /^ *USB powered: true/ { src = src "/USB" }
    /^ *Wireless powered: true/ { src = src "/wireless" }
    /^ *status:/ { split("? unknown charging discharging not-charging full", s, " "); st = s[$2 + 1] }
    END {
      head("POWER", sprintf("%d%%, %s", lvl, st))
      row("Battery", sprintf("%.2f V, %.0f °C", v / 1000, t))
      # Drivers report the current and the charge counter in matching units:
      # uA and uAh (as Android documents), or mA and mAh (as some vendors do).
      micro = cc > 100000
      mah = micro ? cc / 1000 : cc
      if (cur !~ /^-?[0-9]+$/) row("Flow", warn("current unavailable") " \001" dim(dex == "none" ? "(no pw.dex)" : "(pw.dex gave nothing)"))
      else {
        ma = micro ? cur / 1000 : cur
        w = ma * v / 1e6
        if (ma > 20) what = "charging the battery"
        else if (ma >= -20) what = "idle"
        else if (src != "") what = warn("draining: load exceeds charging")
        else what = "system draw"
        row("Flow", sprintf("%+.1f W ", w) what " \001" dim(sprintf("(%+d mA)", ma)))
        # Time left from the charge counter at the current averaged over the
        # last ~10 s of snapshots, reset when the flow turns.
        getline pa < avg; close(avg)
        a = (pa != "" && pa * ma > 0) ? 0.8 * pa + 0.2 * ma : ma
        print a > avg
        if (mah > 0 && lvl > 0 && (a > 20 || a < -20)) {
          if (a < 0) { h = mah / -a; to = "to empty" }
          else { h = (mah * 100 / lvl - mah) / a; to = "to full (less as charging tapers)" }
          row("Remaining", sprintf("%dh %02dm %s \001", h, (h - int(h)) * 60, to) dim(sprintf("at %+.0f mA, %.0f of %.0f mAh", a, mah, mah * 100 / lvl)))
        }
      }
      if (src != "") row("Charger", sprintf("up to %.1f W \001(%.1f A x %.2f V, %s)", mi * mv / 1e12, mi / 1e6, mv / 1e6, substr(src, 2)))
      else row("Charger", dim("none"))
    }'
  echo
  cat out
  echo

  # --- TOP: by CPU and by memory, side by side when the terminal is wide enough.
  for f in top topmem; do grep -vE ' (top|sh|awk|grep|app_process|flock|find)$' $f | head -8 > $f.8; done
  awk -v cols=$COLS "$LIB"'
    # Rows are padded to the column width w by hand: the header is dimmed,
    # and %-*s would count its colour codes.
    function proc(l,   f, n, i, name) {
      n = split(l, f, " "); name = f[4]; for (i = 5; i <= n; i++) name = name " " f[i]
      sub(/:sandboxed_process.*/, " (renderer)", name)
      if (length(name) > nw) name = substr(name, 1, nw - 1) "~"
      return sprintf("  %-7s%5s %5s  %-*s", f[1], f[2], f[3], w - 22, name)
    }
    BEGIN { side = cols >= 100; w = side ? int((cols - 2) / 2) : cols; nw = w - 22; if (nw > 50) nw = 50 }
    FILENAME ~ /topmem/ { m[++nm] = proc($0); next }
    { c[++nc] = proc($0) }
    END {
      hc = dim(sprintf("  %-7s%5s %5s  %-*s", "PID", "%CPU", "MEM", w - 22, "PROCESS"))
      if (side) {
        printf "%s%-*s%s%s\n%s%s\n", ENVIRON["H"], w, "TOP BY CPU", "TOP BY MEMORY", ENVIRON["N"], hc, hc
        for (i = 1; i <= nc || i <= nm; i++) printf("%s%s\n", i <= nc ? c[i] : sprintf("%*s", w, ""), m[i])
      } else {
        head("TOP BY CPU", ""); print hc; for (i = 1; i <= nc; i++) print c[i]
        print ""; head("TOP BY MEMORY", ""); print hc; for (i = 1; i <= nm; i++) print m[i]
      }
    }' top.8 topmem.8 | sed 's/ *$//'
}
snapshot 9> $S/lock
st=$?; kill $WD 2>/dev/null; exit $st
EOF
)"

# Held back until it's all in, so the status line can make way for it in one go
# (errors too: they'd land on the status line). -n: what's typed stays here.
err=$(mktemp)
trap 'rm -f "$err"; unsay' EXIT
say "Connecting to ${label:-${serial:-the device}}…"
out=$(adb shell -n "$script" 2> "$err")
status=$?
if (( status == 3 )); then   # the device's pw.dex is missing or stale
  say "Copying pw.dex to ${label:-${serial:-the device}}…"
  adb shell -n "mkdir -p $T" 2> "$err" && adb push "$dex" $T/pw.dex > /dev/null 2> "$err" &&
    out=$(adb shell -n "$script" 2> "$err")
  status=$?
fi
unsay
[[ -n $out ]] && printf '%s\n' "$out"
cat "$err" >&2
exit $status

